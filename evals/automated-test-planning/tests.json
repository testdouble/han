{
  "plugins": ["han-communication", "han-core", "han-coding"],
  "tests": [
    {
      "name": "Prompt: /automated-test-planning",
      "type": "skill-prompt",
      "promptFile": "prompt-automated-test-planning.md",
      "model": "opus",
      "scaffold": "ruby-project",
      "expect": [
        { "result-contains": "Test Plan" },
        { "skill-call": { "skill": "han-coding:automated-test-planning", "expected": true } }
      ]
    },
    {
      "name": "Prompt: no op",
      "type": "skill-prompt",
      "model": "sonnet",
      "promptFile": "prompt-no-op.md",
      "expect": [
        { "result-does-not-contain": "Test Plan" },
        { "skill-call": { "skill": "han-coding:automated-test-planning", "expected": false } }
      ]
    },
    {
      "name": "Skill Call: /automated-test-planning",
      "type": "skill-call",
      "model": "opus",
      "skillFile": "han-coding:automated-test-planning",
      "promptFile": "skill-call-automated-test-planning.md",
      "scaffold": "ruby-project",
      "expect": [
        { "skill-call": true }
      ]
    },
    {
      "name": "Skill Call: no automated-test-planning",
      "type": "skill-call",
      "model": "sonnet",
      "skillFile": "han-coding:automated-test-planning",
      "promptFile": "skill-call-no-automated-test-planning.md",
      "expect": [
        { "skill-call": false }
      ]
    }
  ]
}
