{
  "plugins": ["han-communication", "han-core", "han-coding", "han-github"],
  "tests": [
    {
      "name": "Prompt: /update-pr-description",
      "type": "skill-prompt",
      "promptFile": "prompt-update-pr-description.md",
      "model": "opus",
      "expect": [
        { "result-contains": "gh CLI" },
        { "skill-call": { "skill": "han-github:update-pr-description", "expected": true } }
      ]
    },
    {
      "name": "Prompt: no op",
      "type": "skill-prompt",
      "model": "sonnet",
      "promptFile": "prompt-no-op.md",
      "expect": [
        { "result-does-not-contain": "gh CLI" },
        { "skill-call": { "skill": "han-github:update-pr-description", "expected": false } }
      ]
    }
  ]
}
