{
  "plugins": ["han-communication", "han-core", "han-coding", "han-research"],
  "tests": [
    {
      "name": "Prompt: /investigate",
      "type": "skill-prompt",
      "promptFile": "prompt-investigate.md",
      "model": "opus",
      "scaffold": "ruby-project",
      "expect": [
        { "result-contains": "Root Cause" },
        { "result-contains": "**Investigation type:** bug" },
        { "skill-call": { "skill": "han-coding:investigate", "expected": true } }
      ]
    },
    {
      "name": "Prompt: /investigate how-it-works",
      "type": "skill-prompt",
      "promptFile": "prompt-how-it-works.md",
      "model": "opus",
      "scaffold": "ruby-shop",
      "expect": [
        { "result-contains": "**Investigation type:** how-it-works" },
        { "result-does-not-contain": "Planned Fix" },
        { "skill-call": { "skill": "han-coding:investigate", "expected": true } }
      ]
    },
    {
      "name": "Prompt: prior art goes to research",
      "type": "skill-prompt",
      "promptFile": "prompt-prior-art.md",
      "model": "sonnet",
      "expect": [{ "skill-call": { "skill": "han-coding:investigate", "expected": false } }]
    },
    {
      "name": "Prompt: no op",
      "type": "skill-prompt",
      "model": "sonnet",
      "promptFile": "prompt-no-op.md",
      "expect": [
        { "result-does-not-contain": "Root Cause" },
        { "skill-call": { "skill": "han-coding:investigate", "expected": false } }
      ]
    },
    {
      "name": "Skill Call: /investigate",
      "type": "skill-call",
      "model": "opus",
      "skillFile": "han-coding:investigate",
      "promptFile": "skill-call-investigate.md",
      "scaffold": "ruby-project",
      "expect": [{ "skill-call": true }]
    },
    {
      "name": "Skill Call: no investigate",
      "type": "skill-call",
      "model": "sonnet",
      "skillFile": "han-coding:investigate",
      "promptFile": "skill-call-no-investigate.md",
      "scaffold": "ruby-project",
      "expect": [{ "skill-call": false }]
    }
  ]
}
